{
  "schema_version": 1,
  "status": "shadow_only_locked_research_configuration",
  "live_enabled": false,
  "automatic_promotion": false,
  "slate": "current_week_mlb_nfl",
  "sports": ["MLB", "NFL"],
  "capital_dollars": 10000,
  "risk_limits_dollars": {
    "per_contract": 500,
    "per_combo": 500,
    "per_fixture": 1000,
    "maximum_committed": 10000,
    "maximum_ticket_gross_liability": 250
